{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/proxy", "function": "proxy" },
      { "source": "/api/samsung-webhook", "function": "samsungWebhook" }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
